# ==============================================================================
# SharVin Platform - Production Environment Variables Template
# Copy to .env.production and populate secrets before launching in production.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Client Application URL (For CORS & Redirection)
CLIENT_URL=https://app.sharvin.in

# PostgreSQL Database Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=prefer
DATABASE_URL=postgresql://sharvin_admin:YOUR_STRONG_DB_PASSWORD@127.0.0.1:5432/sharvin_prod?schema=public

# Database Credentials (for Docker Compose)
POSTGRES_USER=sharvin_admin
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD
POSTGRES_DB=sharvin_prod
POSTGRES_PORT=5432

# Authentication & Security
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHARACTER_CRYPTOGRAPHIC_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Delivery Handover OTP Salt
OTP_SALT=CHANGE_THIS_TO_A_SECURE_SALT_FOR_DELIVERY_OTP_HASHING

# Logging & Monitoring
LOG_LEVEL=info
